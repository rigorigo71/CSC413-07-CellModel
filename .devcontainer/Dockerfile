# The development container for cell-model, generated by the course from
# one template shared by every slice (slices/common/assignment/.devcontainer/
# Dockerfile.erb), so every repository's box is built the same way.
#
# FROM is the grader's own image, on purpose and unchanged. ivan>thron builds
# every submission on eclipse-temurin:25-jdk, so the JDK and the OS you build
# on here are the ones that decide your grade.
#
# A slice that needs a tool for working by hand adds it below, and only
# then: tools for you, never for the build. Your build and your tests must
# not use them. The grader builds its own image from the same base, without
# them, and runs with no network.
FROM eclipse-temurin:25-jdk
